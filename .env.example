# SUPABASE INTEGRATION:
# Set your Supabase project URL and public Anon Key to persist data directly to your PostgreSQL database.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key-here"

